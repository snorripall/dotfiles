// Custom Niri Configuration
// Repo: os/linux/niri/custom.kdl
// Installed to: ~/.config/niri/custom.kdl (via scripts/bootstrap.sh)
// Include this in config.kdl with: include "custom.kdl"

// === LAYOUT: Center-focused 16:9 mode for ultrawide ===
layout {
    gaps 16
    center-focused-column "on-overflow"
    always-center-single-column
    background-color "transparent"
    
    // 16:9 proportion for 3840x1600 screen = 2844px wide
    default-column-width { proportion 0.741; }
    
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.741 // 16:9
        proportion 0.66667
    }
}

// === AUTO-START: Agent Automation Daemon (disabled) ===
// Routes windows spawned by coding agents to the "automation" workspace
// spawn-at-startup "agent-automation-daemon" "start"

// The dummy HDMI dongle advertises 1080p as preferred despite supporting 4K.
output "HDMI-A-1" {
    mode "3840x2160@59.940"
}

// === WINDOW RULES ===
// Chromium: automation workspace, don't steal focus
window-rule {
    match app-id="chromium"
    open-on-workspace "automation"
    open-focused false
}

// Steam games: true fullscreen on gaming-stream
window-rule {
    match app-id=r"^steam_app_"
    exclude title=r"(?i)Battle\.net"
    exclude title=r"^$"
    open-on-workspace "gaming-stream"
    open-fullscreen true
}

// Steam Big Picture Mode: run fullscreen on the TV (HDMI-A-1)
workspace "bigpicture" {
    open-on-output "HDMI-A-1"
}

window-rule {
    match app-id="steam" title="Steam Big Picture Mode"
    open-on-workspace "bigpicture"
    open-fullscreen true
    open-focused true
}

// Slay the Spire 2: gaming-stream with fullscreen
window-rule {
    match title=r"Slay the Spire 2"
    match title=r"slay-the-spire-2"
    open-on-workspace "gaming-stream"
    open-maximized true
    open-fullscreen true
}

// Syncthing Tray: keep its dropdown window floating instead of tiling it
window-rule {
    match app-id=r"(?i)^syncthingtray"
    open-floating true
    default-floating-position x=16 y=16 relative-to="top-right"
}

// === KEYBINDS: Custom shortcuts ===
// Keep capture approval visible even when Steam is on the dummy HDMI output.
window-rule {
    match app-id="xdg-desktop-portal-gnome" title="Share Screen"
    open-on-output "DP-2"
    open-focused true
}

binds {
    Ctrl+F8 repeat=false allow-inhibiting=false hotkey-overlay-title="Toggle Steam primary display" {
        spawn "steam-display-switcher" "toggle" ;
    }
    // Reload Niri config
    Mod+F5 hotkey-overlay-title="Reload Niri config" {
 
        spawn "niri" "msg" "action" "reload-config" ;
    }
    // Switch to automation workspace
    Mod+Shift+A hotkey-overlay-title="Go to Automation workspace" {
        focus-workspace "automation" ;
    }
}
